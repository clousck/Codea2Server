# Copia este archivo a .env (no se sube al repositorio) y descomenta lo que quieras cambiar.
# Sin .env todo funciona con los valores por defecto del docker-compose.yml.

# Clave con la que el visor sube los JSON (cabecera X-API-Key).
# Tiene que ser la misma que lleva JSONUploader.cs en el APK.
#UPLOAD_API_KEY=

# Contraseña del panel web. Vacía, es la misma que UPLOAD_API_KEY.
#DASHBOARD_PASSWORD=

# 1 = el panel se puede ver y descargar sin contraseña. Excluir sesiones,
# escribir notas y subir archivos a mano sigue pidiéndola.
#DASHBOARD_PUBLIC=

# 1 = las sesiones con el JSON anterior al 06/10/2026 también entran en las métricas.
# Por defecto se guardan y se ven, pero quedan fuera del análisis.
#ANALYZE_OLD_FORMAT=

# Zona horaria en la que se muestran las horas.
#DASHBOARD_TZ=America/Guayaquil
