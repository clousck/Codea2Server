# Copia este archivo a .env (no se sube al repositorio) y descomenta lo que quieras cambiar.
# Sin .env todo funciona con los valores por defecto del docker-compose.yml.

# Clave con la que el visor sube los JSON (cabecera X-API-Key).
# Tiene que ser la misma que lleva JSONUploader.cs en el APK.
#UPLOAD_API_KEY=

# Contraseña del panel web. Vacía, es la misma que UPLOAD_API_KEY.
#DASHBOARD_PASSWORD=

# 1 = el panel se puede ver y descargar sin contraseña. Excluir sesiones,
# escribir notas y subir archivos a mano sigue pidiéndola.
#DASHBOARD_PUBLIC=

# 1 = las sesiones con el JSON anterior al 06/10/2026 también entran en las métricas.
# Por defecto se guardan y se ven, pero quedan fuera del análisis.
#ANALYZE_OLD_FORMAT=

# Zona horaria en la que se muestran las horas.
#DASHBOARD_TZ=America/Guayaquil

# De quién se aceptan las cabeceras X-Forwarded-* (IP real del cliente y si fue HTTPS).
# * = de cualquiera: lo correcto detrás de un proxy (el túnel de Cloudflare, Caddy, el
# proxy de TI). no = de nadie: cuando el 26332 se publica directo a internet, sin proxy,
# porque entonces esas cabeceras las escribe el cliente y podría falsear su IP.
#TRUSTED_PROXY=*

# Desde dónde se puede entrar al 26332. Vacío: desde cualquier equipo de la red.
# 127.0.0.1: solo desde la propia máquina (cuando delante va nginx, Apache, IIS o Caddy).
#CODEA2_BIND=

# Solo con docker-compose.https.yml: el dominio que apunta a la IP pública del servidor.
# Caddy saca y renueva solo el certificado HTTPS para él.
#CODEA2_DOMINIO=codea2.ejemplo.edu.ec
